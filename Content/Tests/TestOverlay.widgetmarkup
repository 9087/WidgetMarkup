<WidgetBlueprint Script="Tests.TestOverlay">
  <WidgetTree>
    <Overlay Name="TestOverlayPanel" Visibility="Visible">
      <TextBlock Name="OverlayChild1" Text="layer1"
                 Slot.Padding="4,2"
                 Slot.HorizontalAlignment="HAlign_Fill"
                 Slot.VerticalAlignment="VAlign_Fill" />
      <TextBlock Name="OverlayChild2" Text="layer2"
                 Slot.Padding="8,4"
                 Slot.HorizontalAlignment="HAlign_Right"
                 Slot.VerticalAlignment="VAlign_Bottom" />
    </Overlay>
  </WidgetTree>
</WidgetBlueprint>
